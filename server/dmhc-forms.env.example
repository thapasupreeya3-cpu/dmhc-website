# Copy this to /etc/dmhc-forms.env on the server, fill in the password,
# then lock it down:
#     sudo chown root:root /etc/dmhc-forms.env
#     sudo chmod 600 /etc/dmhc-forms.env
#
# The real file must NEVER be committed to GitHub. Only this example belongs
# in the repository.

DMHC_SMTP_HOST=smtp.zoho.com.au
DMHC_SMTP_PORT=465
DMHC_SMTP_USER=info@dmhcare.com.au
DMHC_SMTP_PASS=paste-the-zoho-app-password-here
DMHC_MAIL_TO=info@dmhcare.com.au
DMHC_SENDER_NAME=DMHC Website
DMHC_PORT=8787
